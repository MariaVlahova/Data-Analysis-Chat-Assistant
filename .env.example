# Copy to .env and fill in. Real environment variables win over this file.
# Never commit .env.

# Gemini API key (plan 04)
GEMINI_API_KEY=

# Google Cloud project that BigQuery jobs run (and are billed) in
GOOGLE_CLOUD_PROJECT=

# Optional: path to a service-account JSON key.
# Leave empty to use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional overrides
# OPSFLEET_CONFIG=config.yaml
